<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OOP</RootNamespace>
    <AssemblyName>OOP</AssemblyName>
    <Deterministic>true</Deterministic>
    <!-- Keep custom AssemblyInfo if present -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Disable implicit/default compile items so that explicit includes below don't duplicate -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Preserve App.config if used -->
    <None Include="App.config" />
    <!-- Include existing source files in OOP folder and Program/AssemblyInfo -->
    <Compile Include="OOP\*.cs" />
    <Compile Include="OOP\Entities\LibraryContext.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.0" />
  </ItemGroup>

</Project>
