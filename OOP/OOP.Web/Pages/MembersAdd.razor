@page "/members/add"
@inject OOP.Repositories.IMemberRepository MemberRepository
@inject NavigationManager Navigation

<h3>Registrera medlem</h3>

<EditForm Model="newMember" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>MemberId</label>
        <InputText @bind-Value="newMember.MemberId" class="form-control" />
        <ValidationMessage For="() => newMember.MemberId" />
    </div>

    <div class="form-group">
        <label>Namn</label>
        <InputText @bind-Value="newMember.Name" class="form-control" />
        <ValidationMessage For="() => newMember.Name" />
    </div>

    <div class="form-group">
        <label>E-post</label>
        <InputText @bind-Value="newMember.Email" class="form-control" />
        <ValidationMessage For="() => newMember.Email" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
</EditForm>

@code {
    private MemberEntity newMember = new MemberEntity { MemberSince = DateTime.Now };

    private async Task HandleSubmit()
    {
        await MemberRepository.AddAsync(newMember);
        Navigation.NavigateTo("/members");
    }
}
