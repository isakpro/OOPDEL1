@page "/books/add"
@inject OOP.Repositories.IBookRepository BookRepository
@inject NavigationManager Navigation

<h3>Lägg till bok</h3>

<EditForm Model="newBook" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>ISBN</label>
        <InputText @bind-Value="newBook.ISBN" class="form-control" />
        <ValidationMessage For="() => newBook.ISBN" />
    </div>

    <div class="form-group">
        <label>Titel</label>
        <InputText @bind-Value="newBook.Title" class="form-control" />
        <ValidationMessage For="() => newBook.Title" />
    </div>

    <div class="form-group">
        <label>Författare</label>
        <InputText @bind-Value="newBook.Author" class="form-control" />
        <ValidationMessage For="() => newBook.Author" />
    </div>

    <div class="form-group">
        <label>Utgivningsår</label>
        <InputNumber @bind-Value="newBook.PublishedYear" class="form-control" />
        <ValidationMessage For="() => newBook.PublishedYear" />
    </div>

    <button type="submit" class="btn btn-primary">Spara</button>
</EditForm>

@code {
    private Book newBook = new Book();

    private async Task HandleSubmit()
    {
        await BookRepository.AddAsync(newBook);
        Navigation.NavigateTo("/books");
    }
}
