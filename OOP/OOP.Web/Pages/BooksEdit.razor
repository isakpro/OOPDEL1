@page "/books/edit/{Id:int}"
@inject OOP.Repositories.IBookRepository BookRepository
@inject NavigationManager Navigation

<h3>Redigera bok</h3>

@if (book == null)
{
    <p>Bok hittades inte.</p>
}
else
{
    <EditForm Model="book" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>ISBN</label>
            <InputText @bind-Value="book.ISBN" class="form-control" />
            <ValidationMessage For="() => book.ISBN" />
        </div>

        <div class="form-group">
            <label>Titel</label>
            <InputText @bind-Value="book.Title" class="form-control" />
            <ValidationMessage For="() => book.Title" />
        </div>

        <div class="form-group">
            <label>Författare</label>
            <InputText @bind-Value="book.Author" class="form-control" />
            <ValidationMessage For="() => book.Author" />
        </div>

        <div class="form-group">
            <label>Utgivningsår</label>
            <InputNumber @bind-Value="book.PublishedYear" class="form-control" />
            <ValidationMessage For="() => book.PublishedYear" />
        </div>

        <button type="submit" class="btn btn-primary">Spara</button>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Book? book;

    protected override async Task OnInitializedAsync()
    {
        book = await BookRepository.GetByIdAsync(Id);
    }

    private async Task HandleSubmit()
    {
        if (book != null)
        {
            await BookRepository.UpdateAsync(book);
            Navigation.NavigateTo($"/books/{book.Id}");
        }
    }
}
