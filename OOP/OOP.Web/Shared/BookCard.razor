@using OOP
@namespace OOP.Web.Shared

<div class="card @(Book.IsAvailable ? "available" : "borrowed")">
    <h3>@Book.Title</h3>
    <p>@Book.Author (@Book.PublishedYear)</p>
    <span class="status">@(Book.IsAvailable ? "Tillgänglig" : "Utlånad")</span>
</div>

@code {
    [Parameter]
    public Book Book { get; set; } = default!;
}
